from pathlib import Path
from datetime import datetime
from typing import Dict, List, Any

class SimpleMCPFileServer:
    """
    A simplified MCP File Server demonstrating the three primitives.
    In a real implementation, this would use the official MCP SDK.
    """
    
    def __init__(self, root_directory: str = "."):
        self.root = Path(root_directory).resolve()
        self.name = "Demo File System MCP Server"
        self.version = "1.0.0"
    
    # =============================================================================
    # RESOURCES: Static file information
    # =============================================================================
    
    async def list_resources(self) -> List[Dict[str, Any]]:
        """List all files as resources"""
        resources = []
        try:
            for file_path in self.root.rglob("*.py"):  # Only Python files for demo
                if file_path.is_file():
                    relative_path = file_path.relative_to(self.root)
                    resources.append({
                        "uri": f"file://{relative_path}",
                        "name": file_path.name,
                        "description": f"Python file: {relative_path}",
                        "mimeType": "text/x-python"
                    })
        except Exception as e:
            print(f"Error listing resources: {e}")
        return resources[:5]  # Limit for demo
    
    async def read_resource(self, uri: str) -> str:
        """Read a file resource"""
        try:
            path = uri.replace("file://", "")
            file_path = self.root / path
            
            if not file_path.exists():
                return f"Error: File not found: {path}"
            
            # Security check: ensure path is within root
            if not str(file_path.resolve()).startswith(str(self.root)):
                return "Error: Access denied - path outside root directory"
            
            return file_path.read_text(encoding='utf-8', errors='ignore')[:1000]  # Limit for demo
        
        except Exception as e:
            return f"Error reading file: {e}"
    
    # =============================================================================
    # TOOLS: Interactive file operations
    # =============================================================================
    
    async def list_files_tool(self, directory: str = ".") -> Dict[str, Any]:
        """Tool: List files in a directory"""
        try:
            dir_path = self.root / directory
            
            if not dir_path.exists():
                return {"error": f"Directory not found: {directory}"}
            
            files = []
            for item in dir_path.iterdir():
                if item.name.startswith('.'):  # Skip hidden files for demo
                    continue
                files.append({
                    "name": item.name,
                    "type": "directory" if item.is_dir() else "file",
                    "size": item.stat().st_size if item.is_file() else None,
                    "modified": datetime.fromtimestamp(item.stat().st_mtime).isoformat()
                })
            
            return {"files": files[:10], "directory": str(directory)}  # Limit for demo
        
        except Exception as e:
            return {"error": f"Error listing files: {e}"}
    
    async def create_file_tool(self, path: str, content: str) -> Dict[str, Any]:
        """Tool: Create a new file with content"""
        try:
            file_path = self.root / path
            
            # Security check
            if not str(file_path.resolve().parent).startswith(str(self.root)):
                return {"error": "Access denied - path outside root directory"}
            
            # Create parent directories if needed
            file_path.parent.mkdir(parents=True, exist_ok=True)
            
            # Write file
            file_path.write_text(content, encoding='utf-8')
            
            return {
                "success": True,
                "message": f"File created: {path}",
                "size": len(content)
            }
        
        except Exception as e:
            return {"error": f"Error creating file: {e}"}
    
    async def file_stats_tool(self, path: str) -> Dict[str, Any]:
        """Tool: Get detailed file statistics"""
        try:
            file_path = self.root / path
            
            if not file_path.exists():
                return {"error": f"Path not found: {path}"}
            
            stat = file_path.stat()
            
            return {
                "path": str(path),
                "name": file_path.name,
                "size": stat.st_size,
                "created": datetime.fromtimestamp(stat.st_ctime).isoformat(),
                "modified": datetime.fromtimestamp(stat.st_mtime).isoformat(),
                "is_file": file_path.is_file(),
                "is_directory": file_path.is_dir(),
                "extension": file_path.suffix if file_path.is_file() else None
            }
        
        except Exception as e:
            return {"error": f"Error getting file stats: {e}"}
    
    # =============================================================================
    # PROMPTS: Templates for common tasks
    # =============================================================================
    
    async def analyze_project_prompt(self, directory: str = ".") -> str:
        """Prompt: Generate project analysis template"""
        return f"""
Please analyze the project structure in '{directory}' and provide insights:

Use the available tools to:
1. List all files in the directory (use list_files_tool)
2. Check file statistics for key files (use file_stats_tool)
3. Read important configuration or documentation files (use read_resource)

Provide analysis on:
📊 **Project Structure**
- What type of project is this?
- What programming languages are used?
- What frameworks or libraries are evident?

📁 **File Organization**
- How well organized are the files?
- Are there proper separation of concerns?
- Any missing important files?

⚡ **Recommendations**
- Suggested improvements to structure
- Missing documentation or configuration
- Best practices that could be applied

Please format your response with clear sections and actionable insights.
"""
    
    async def code_review_prompt(self, file_path: str) -> str:
        """Prompt: Generate code review template for a specific file"""
        return f"""
Please perform a comprehensive code review of '{file_path}':

First, read the file content using read_resource with URI: file://{file_path}

Then provide detailed feedback on:

🔍 **Code Analysis**
- Code quality and readability
- Adherence to best practices
- Potential bugs or issues
- Performance considerations

🛡️ **Security Review**
- Any security vulnerabilities
- Input validation concerns
- Error handling adequacy

📚 **Documentation**
- Code comments quality
- Function/class documentation
- API documentation if applicable

💡 **Improvement Suggestions**
- Specific refactoring recommendations
- Code optimization opportunities
- Testing suggestions

Rate each category (1-5 stars) and provide specific examples from the code.
"""

# Let's create an instance and test it
print("🛠️ Complete MCP File Server Demo")
print("=" * 60)

