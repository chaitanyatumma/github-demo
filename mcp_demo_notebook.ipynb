# Example 2: Tool - A simple calculator function
def calculator_tool(operation: str, a: float, b: float) -> dict:
    """
    Tool: Perform basic mathematical operations
    """
    operations = {
        "add": lambda x, y: x + y,
        "subtract": lambda x, y: x - y,
        "multiply": lambda x, y: x * y,
        "divide": lambda x, y: x / y if y != 0 else None
    }
    
    if operation not in operations:
        return {"error": f"Unsupported operation: {operation}"}
    
    try:
        result = operations[operation](a, b)
        if result is None:
            return {"error": "Division by zero"}
        
        return {
            "operation": operation,
            "operand_a": a,
            "operand_b": b,
            "result": result,
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {"error": f"Calculation error: {e}"}

# Example 3: Prompt - Template for code review
def code_review_prompt(language: str, code_snippet: str) -> str:
    """
    Prompt: Generate a structured code review template
    """
    return f"""
Please review the following {language} code and provide feedback:

```{language}
{code_snippet}
```

Focus on:
1. **Code Quality**: Is the code clean and readable?
2. **Best Practices**: Does it follow {language} conventions?
3. **Performance**: Are there any optimization opportunities?
4. **Security**: Are there any security concerns?
5. **Maintainability**: How easy would this be to maintain?

For each point, provide:
- ✅ What's good
- ⚠️ Areas for improvement  
- 💡 Specific recommendations

Use the calculator_tool if you need to verify any mathematical calculations in the code.
"""

